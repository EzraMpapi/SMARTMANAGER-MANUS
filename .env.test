# Real Supabase Auth + Vercel Preview E2E configuration.
# Replace every <...> value through CI secrets or a local secret manager.
# Never commit real credentials, JWTs, service-role keys, or production URLs.

E2E_REAL_AUTH=1

# Exact HTTPS Vercel preview URL and hostname approved for this test run.
# Do not use menejajanja.vercel.app or smartmanager-manus.vercel.app.
E2E_BASE_URL=https://<approved-preview-deployment>.vercel.app
E2E_PREVIEW_HOST=<approved-preview-deployment>.vercel.app

# Visible tenant names/markers used to prove tenant isolation in the UI.
E2E_TENANT_A_MARKER=<isolated-tenant-a-display-name>
E2E_TENANT_B_MARKER=<isolated-tenant-b-display-name>

# Disposable Supabase Auth fixture A: authorized in tenant A.
E2E_USER_A_EMAIL=<disposable-user-a-email>
E2E_USER_A_PASSWORD=<disposable-user-a-password>

# Disposable Supabase Auth fixture B: authorized only in tenant B.
E2E_USER_B_EMAIL=<disposable-user-b-email>
E2E_USER_B_PASSWORD=<disposable-user-b-password>

# Disposable Supabase Auth fixture with a valid login but no complete
# profile/membership/workspace identity. It must remain fail-closed.
E2E_INCOMPLETE_EMAIL=<disposable-incomplete-user-email>
E2E_INCOMPLETE_PASSWORD=<disposable-incomplete-user-password>
