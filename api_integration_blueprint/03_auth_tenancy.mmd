  TENANT["Tenant binding\nconnection.company_id only\nnever trust body company_id"]
  ACTOR["Actor context\nservice principal + optional human actor"]
  RBAC["Scope + role authorization\nread · write · post · approve · reconcile"]
  RLS["Supabase RLS / secured RPC\ncompany-scoped row visibility"]
  AUDIT["Audit evidence\nrequest hash · actor · source · decision"]
