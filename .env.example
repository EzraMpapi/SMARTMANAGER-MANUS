# Smart Manager server-side billing integration
# Never commit real credentials. Configure these only in the deployment environment.

# Optional desktop wrapper target. This is an HTTPS application URL, not a secret.
# Leave unset to use https://menejajanja.vercel.app/app.
SMART_MANAGER_APP_URL=https://menejajanja.vercel.app/app

# Existing Supabase server integration
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SECRET_KEY=
# Private Supabase Storage bucket used for product images, avatars, documents, and branding.
# The server creates it on first upload when it does not already exist.
SUPABASE_STORAGE_BUCKET=smart-manager

# Browser-visible notification configuration. The anon key and VAPID public key are not secrets.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_WEB_PUSH_PUBLIC_KEY=

# Supabase Edge Function secrets: configure in Supabase, never in this file or frontend code.
# SUPABASE_SERVICE_ROLE_KEY=
# FCM_SERVICE_ACCOUNT_JSON=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:notifications@example.com

# HarakaPay: server-side only. Do not use any VITE_ prefix for these values.
HARAKAPAY_API_KEY=
HARAKAPAY_BASE_URL=https://harakapay.net
# Required because the supplied contract does not specify the provider's collection URL path.
HARAKAPAY_COLLECT_URL=
# Public HTTPS callback URL configured with HarakaPay, for example:
# https://your-domain.example/api/payments/harakapay/webhook
HARAKAPAY_WEBHOOK_URL=

# Optional generic GPS/IoT ingress. Configure after selecting a telematics provider.
FLEET_TELEMATICS_WEBHOOK_SECRET=
