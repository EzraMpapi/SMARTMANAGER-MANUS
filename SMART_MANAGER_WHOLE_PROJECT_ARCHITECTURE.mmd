    FRAUD["AML / fraud controls\nrisk flags · alerts · review states"]
    PROTECTED --> TENANT
    PROTECTED --> ROLES
    SERVICES --> MAKER
    SERVICES --> IDEMPOTENCY
    SERVICES --> FRAUD
    TENANT --> RLS
    MAKER --> AUDIT
    IDEMPOTENCY --> AUDIT
    FRAUD --> AUDIT
  end

