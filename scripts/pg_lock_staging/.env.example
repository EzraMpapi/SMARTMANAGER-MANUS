# Copy to a local, untracked file such as .env.pg-lock-staging and source it before provision.sh.
ENVIRONMENT=staging
POSTGRES_PASSWORD=replace-with-a-disposable-random-password
POSTGRES_PORT=55432

# Both containers receive the same run ID and account key so they exercise the same advisory-lock key.
RUN_ID=pg-lock-staging-run-001
PROVIDER=STAGING_TEST_PROVIDER
PROVIDER_ACCOUNT_KEY=staging-hot-account
MODE=duplicates
PROCESSES=4
BATCH_SIZE=250
HOLD_LOCK_MS=2
JITTER_MIN_MS=0
JITTER_MAX_MS=0
JITTER_SEED=20260825

# Do not set DATABASE_DSN to a production or managed Supabase endpoint.
